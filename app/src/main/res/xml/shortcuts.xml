        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.example.supacomobile"
            android:targetClass="com.example.supacomobile.MainActivity">
            <extra android:name="dest" android:value="horarios" />
        </intent>
    </shortcut>

    <shortcut
        android:shortcutId="materias"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_book"
        android:shortcutShortLabel="@string/shortcut_materias_short"
        android:shortcutLongLabel="@string/shortcut_materias_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.example.supacomobile"
            android:targetClass="com.example.supacomobile.MainActivity">
            <extra android:name="dest" android:value="materias" />
        </intent>
